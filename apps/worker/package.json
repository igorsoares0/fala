    "@fala/shared": "*",
    "@fala/storage": "*",
    "tsx": "4.23.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "dotenv-cli": "^11.0.0"
  }
}
