# Copy to `.env` at the repo root. Never commit real values.

# Database (local Postgres from docker-compose.yml; Neon in deployed environments)
# Production on Neon: DATABASE_URL is the pooled URL (the app); DIRECT_DATABASE_URL the
# direct one (migrations, which need session features the pooler lacks).
DATABASE_URL="postgresql://fala:fala@localhost:5434/fala_dev"
DATABASE_URL_TEST="postgresql://fala:fala@localhost:5434/fala_test"

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional in development; the button is disabled without them)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Object storage (Cloudflare R2 in deployed environments; SeaweedFS from docker-compose.yml locally)
R2_ENDPOINT="http://localhost:8333"
R2_REGION="auto"
R2_ACCESS_KEY_ID="fala"
R2_SECRET_ACCESS_KEY="fala-local-secret"
R2_BUCKET_NAME="fala-dev"
R2_BUCKET_NAME_TEST="fala-test"

# Worker
WORKER_CONCURRENCY="1"
TEMP_DIR="/tmp/fala-worker"
# Transcription: "assemblyai" for real captions, or "fake" for scripted ones while developing
# without a key (never in production). The key is only needed by the worker.
TRANSCRIPTION_PROVIDER="fake"
ASSEMBLYAI_API_KEY=""
# Optional: https://api.eu.assemblyai.com to keep processing in the EU
ASSEMBLYAI_BASE_URL=""
# Optional: ffmpeg/ffprobe binaries when they aren't on PATH
FFMPEG_PATH=""
FFPROBE_PATH=""

# Paddle Billing. PADDLE_ENV is "sandbox" or "production". The API key and the
# client-side token come from Paddle → Developer tools → Authentication; the webhook
# secret from the notification destination (npm run paddle:tunnel sets one up locally).
PADDLE_ENV="sandbox"
PADDLE_API_KEY=""
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
PADDLE_WEBHOOK_SECRET=""
# Price ids of the Fala Creator / Fala Pro products (monthly and yearly).
PADDLE_PRICE_CREATOR_MONTHLY=""
PADDLE_PRICE_CREATOR_YEARLY=""
PADDLE_PRICE_PRO_MONTHLY=""
PADDLE_PRICE_PRO_YEARLY=""

# Email (Resend). Without RESEND_API_KEY, development prints emails to the worker log.
# The test sender only delivers to the Resend account owner's address; use a verified
# domain's address in production.
RESEND_API_KEY=""
EMAIL_FROM="Fala <onboarding@resend.dev>"
# Base of links in emails (the web app's public URL).
APP_URL="http://localhost:3000"

# Deep health check (/api/health?deep=1&token=…) for uptime monitoring.
HEALTH_TOKEN=""
DIRECT_DATABASE_URL=""
