# Copy to `.env` at the repo root. Never commit real values.

# Database (local Postgres from docker-compose.yml; Neon in deployed environments)
DATABASE_URL="postgresql://fala:fala@localhost:5434/fala_dev"
DATABASE_URL_TEST="postgresql://fala:fala@localhost:5434/fala_test"

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional in development; the button is disabled without them)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
