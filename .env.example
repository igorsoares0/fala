# Copy to `.env` at the repo root. Never commit real values.

# Database (local Postgres from docker-compose.yml; Neon in deployed environments)
DATABASE_URL="postgresql://fala:fala@localhost:5434/fala_dev"
DATABASE_URL_TEST="postgresql://fala:fala@localhost:5434/fala_test"

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional in development; the button is disabled without them)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Object storage (Cloudflare R2 in deployed environments; SeaweedFS from docker-compose.yml locally)
R2_ENDPOINT="http://localhost:8333"
R2_REGION="auto"
R2_ACCESS_KEY_ID="fala"
R2_SECRET_ACCESS_KEY="fala-local-secret"
R2_BUCKET_NAME="fala-dev"
R2_BUCKET_NAME_TEST="fala-test"

# Worker
WORKER_CONCURRENCY="1"
TEMP_DIR="/tmp/fala-worker"
# Optional: ffmpeg/ffprobe binaries when they aren't on PATH
FFMPEG_PATH=""
FFPROBE_PATH=""
