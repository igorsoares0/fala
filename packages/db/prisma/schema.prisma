// Fala database schema. Connection settings live in ../prisma.config.ts.
// Conventions: timestamps/durations in integer milliseconds; JSON columns are
// validated with zod schemas from @fala/shared on read and write.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth models ──────────────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  /// "Email me when an export finishes" (Account → Preferences).
  emailOnExport Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  projects      Project[]
  subscription  Subscription?
  usageEntries  UsageEntry[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Product models ──────────────────────────────────────────────────────────

/// Mirrors PROJECT_STATUSES in @fala/shared (spec §6.1).
enum ProjectStatus {
  CREATED
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  RENDERING
  COMPLETED
  FAILED
  DELETION_PENDING
  DELETED
}

model Project {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  status             ProjectStatus @default(CREATED)
  sourceObjectKey    String?
  /// Multipart upload in progress for `sourceObjectKey` (cleared once completed or aborted).
  sourceUploadId     String?
  /// Size the browser declared for that upload; the finished upload must match it.
  sourceSizeBytes    BigInt?
  thumbnailObjectKey String?
  durationMs         Int?
  width              Int?
  height             Int?
  sourceMimeType     String?
  videoCodec         String?
  audioCodec         String?
  /// Set when status is FAILED; one of PROJECT_ERROR_CODES in @fala/shared.
  errorCode          String?
  /// First caption block's words, for the dashboard card's caption sample.
  captionSample      Json?
  /// Last time the user worked on it (editor opened, edits saved, export started): drives source retention.
  lastActiveAt       DateTime      @default(now())
  /// When the "original will be removed" warning was sent.
  sourceExpiryWarnedAt DateTime?
  /// The original video was removed by the retention policy; captions stay, export needs a new upload.
  sourceDeletedAt    DateTime?
  jobs               Job[]
  transcript         Transcript?
  captionTrack       CaptionTrack?
  style              ProjectStyle?
  exports            Export[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  @@index([userId, deletedAt, createdAt])
  @@index([status])
  @@map("project")
}

enum JobType {
  VALIDATE_VIDEO
  TRANSCRIBE_VIDEO
  RENDER_EXPORT
  DELETE_PROJECT_ASSETS
  SEND_EMAIL
  RETENTION_SWEEP
  DELETE_ACCOUNT_ASSETS
}

enum JobStatus {
  PENDING
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Postgres-backed job queue (spec §7). Workers claim rows with FOR UPDATE SKIP LOCKED
/// and hold a lease; an expired lease makes a RUNNING job claimable again.
model Job {
  id               String    @id @default(cuid())
  /// Null for account-level work (emails, retention, account deletion).
  projectId        String?
  project          Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// At most one job per key (e.g. one email per occurrence, one retention sweep per hour).
  dedupeKey        String?   @unique
  /// Set for RENDER_EXPORT jobs.
  exportId         String?
  export           Export?   @relation(fields: [exportId], references: [id], onDelete: Cascade)
  type             JobType
  status           JobStatus @default(PENDING)
  payload          Json
  attempts         Int       @default(0)
  maxAttempts      Int       @default(3)
  availableAt      DateTime  @default(now())
  lockedBy         String?
  lockedAt         DateTime?
  leaseExpiresAt   DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  lastErrorCode    String?
  /// Sanitized: no URLs, keys or credentials.
  lastErrorMessage String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([projectId])
  @@index([exportId])
  @@map("job")
}

/// What the transcription provider returned, kept unchanged so edits never lose
/// the original word timings (spec §9.3). Tied to the upload it was made from.
model Transcript {
  id                 String   @id @default(cuid())
  projectId          String   @unique
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceObjectKey    String
  provider           String
  model              String?
  language           String?
  languageConfidence Float?
  fullText           String
  /// TranscriptWord[] (see captionTrackSchema in @fala/shared).
  words              Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("transcript")
}

/// The captions the editor shows and edits: { words, blocks } validated by
/// captionTrackSchema. `version` increases on every save (optimistic concurrency).
model CaptionTrack {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  language  String?
  words     Json
  blocks    Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("caption_track")
}

/// The project's caption style: the preset it started from plus the full configuration
/// (validated with captionStyleSchema). Absent until the user changes the style.
model ProjectStyle {
  id            String   @id @default(cuid())
  projectId     String   @unique
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  presetKey     String
  configuration Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("project_style")
}

enum ExportStatus {
  QUEUED
  RENDERING
  SUCCEEDED
  FAILED
  /// Removed by the retention policy; render again for a new file.
  EXPIRED
}

/// One rendered MP4 (spec FR-11, FR-12). Never overwritten: a new render is a new version.
model Export {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// v1, v2… per project.
  version       Int
  status        ExportStatus @default(QUEUED)
  /// 0–100 while rendering.
  progress      Int          @default(0)
  /// Requested short side (720 or 1080).
  resolution    Int
  /// Frozen captions, style and source (`exportSnapshotSchema`); later edits never change it.
  snapshot      Json
  objectKey     String?
  width         Int?
  height        Int?
  durationMs    Int?
  fileSizeBytes Int?
  errorCode     String?
  jobs          Job[]
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([projectId, version])
  @@index([projectId, createdAt])
  @@index([status])
  @@map("export")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

/// A user's paid plan (spec FR-13). No row means the Free plan.
model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// A key of PLANS in @fala/shared: the plan in effect now.
  planKey              String
  /// A downgrade that takes effect when the current period ends.
  pendingPlanKey       String?
  /// "month" or "year".
  billingInterval      String             @default("month")
  status               SubscriptionStatus @default(ACTIVE)
  /// A scheduled cancellation: the plan stays until then.
  cancelAt             DateTime?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  paddleCustomerId     String?            @unique
  paddleSubscriptionId String?            @unique
  /// `updated_at` of the newest Paddle state applied: older events never overwrite it.
  paddleUpdatedAt      DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscription")
}

enum UsageStatus {
  RESERVED
  CONFIRMED
  RELEASED
}

enum UsageType {
  TRANSCRIPTION
}

/// Usage ledger (spec FR-14): reserved before work that costs money, then confirmed or released.
model UsageEntry {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?
  /// Billing period it counts against: "2026-10" (calendar month) or the subscription period's start.
  periodKey      String
  usageType      UsageType
  seconds        Int
  status         UsageStatus @default(RESERVED)
  /// One entry per billable operation, e.g. "transcription:{projectId}:{uploadId}".
  idempotencyKey String      @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId, periodKey])
  @@index([projectId])
  @@map("usage_entry")
}

/// Paddle webhook events already processed (spec §13.2): a replayed event is ignored.
model PaddleEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  type        String
  receivedAt  DateTime @default(now())

  @@map("paddle_event")
}

/// Liveness of each worker process, for the deep health check (stale = not seen for a while).
model WorkerHeartbeat {
  workerId    String   @id
  lastSeenAt  DateTime
  runningJobs Int      @default(0)
  startedAt   DateTime @default(now())

  @@map("worker_heartbeat")
}

/// Fixed-window counters for per-user limits on expensive actions (exports, uploads).
model RateLimitBucket {
  /// "{action}:{userId}:{windowStart}"
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limit_bucket")
}
