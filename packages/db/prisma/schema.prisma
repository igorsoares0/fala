// Fala database schema. Connection settings live in ../prisma.config.ts.
// Conventions: timestamps/durations in integer milliseconds; JSON columns are
// validated with zod schemas from @fala/shared on read and write.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth models ──────────────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  projects      Project[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Product models ──────────────────────────────────────────────────────────

/// Mirrors PROJECT_STATUSES in @fala/shared (spec §6.1).
enum ProjectStatus {
  CREATED
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  RENDERING
  COMPLETED
  FAILED
  DELETION_PENDING
  DELETED
}

model Project {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  status             ProjectStatus @default(CREATED)
  sourceObjectKey    String?
  thumbnailObjectKey String?
  durationMs         Int?
  width              Int?
  height             Int?
  sourceMimeType     String?
  videoCodec         String?
  audioCodec         String?
  /// Set when status is FAILED; one of PROJECT_ERROR_CODES in @fala/shared.
  errorCode          String?
  /// First caption block's words, for the dashboard card's caption sample.
  captionSample      Json?
  jobs               Job[]
  transcript         Transcript?
  captionTrack       CaptionTrack?
  style              ProjectStyle?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  @@index([userId, deletedAt, createdAt])
  @@index([status])
  @@map("project")
}

enum JobType {
  VALIDATE_VIDEO
  TRANSCRIBE_VIDEO
  DELETE_PROJECT_ASSETS
}

enum JobStatus {
  PENDING
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Postgres-backed job queue (spec §7). Workers claim rows with FOR UPDATE SKIP LOCKED
/// and hold a lease; an expired lease makes a RUNNING job claimable again.
model Job {
  id               String    @id @default(cuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type             JobType
  status           JobStatus @default(PENDING)
  payload          Json
  attempts         Int       @default(0)
  maxAttempts      Int       @default(3)
  availableAt      DateTime  @default(now())
  lockedBy         String?
  lockedAt         DateTime?
  leaseExpiresAt   DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  lastErrorCode    String?
  /// Sanitized: no URLs, keys or credentials.
  lastErrorMessage String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([projectId])
  @@map("job")
}

/// What the transcription provider returned, kept unchanged so edits never lose
/// the original word timings (spec §9.3). Tied to the upload it was made from.
model Transcript {
  id                 String   @id @default(cuid())
  projectId          String   @unique
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceObjectKey    String
  provider           String
  model              String?
  language           String?
  languageConfidence Float?
  fullText           String
  /// TranscriptWord[] (see captionTrackSchema in @fala/shared).
  words              Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("transcript")
}

/// The captions the editor shows and edits: { words, blocks } validated by
/// captionTrackSchema. `version` increases on every save (optimistic concurrency).
model CaptionTrack {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  language  String?
  words     Json
  blocks    Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("caption_track")
}

/// The project's caption style: the preset it started from plus the full configuration
/// (validated with captionStyleSchema). Absent until the user changes the style.
model ProjectStyle {
  id            String   @id @default(cuid())
  projectId     String   @unique
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  presetKey     String
  configuration Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("project_style")
}
