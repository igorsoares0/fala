{
  "name": "fala",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @fala/web",
    "build": "npm run build -w @fala/web",
    "start": "npm run start -w @fala/web",
    "lint": "npm run lint -w @fala/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e -w @fala/web",
    "db:generate": "npm run generate -w @fala/db",
    "db:migrate": "npm run migrate -w @fala/db"
  },
  "devDependencies": {
    "@types/node": "^24",
    "dotenv": "^17",
    "typescript": "^5",
    "vitest": "^4"
  }
}
